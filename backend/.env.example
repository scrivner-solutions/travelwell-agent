# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# The only knob that picks a database. Unset = the compose container below.
# app/db/engine.py owns the driver and TLS, so one value serves both the app
# and alembic; TLS is required automatically for any host that is not a unix
# socket or localhost.
#   compose    postgresql+psycopg://travelwell:travelwell@localhost:5432/travelwell
#   Cloud SQL  postgresql+psycopg://USER:PASS@/travelwell?host=/cloudsql/PROJECT:REGION:INSTANCE
#   hosted     postgresql+psycopg://USER:PASS@HOST:5432/DBNAME
# DATABASE_URL=

# Required: dev opt-in. Allows the insecure dev session secret and logs
# sign-in codes to the server log. Never set outside local development;
# deployed environments set SESSION_SECRET instead.
APP_ENV=dev
# SESSION_SECRET=any-long-random-string

# Google OAuth sign-in (from the GCP console OAuth client). Unset = the
# "Continue with Google" endpoint answers 503 and email-code still works.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx

# Origin the browser uses to reach the app (vite dev server locally, the
# deployed frontend URL in staging). Builds the OAuth redirect_uri, so it
# must match one registered on the OAuth client.
# PUBLIC_BASE_URL=http://localhost:5173

# Staging gate: comma-separated emails allowed to sign in (both providers).
# Unset/empty = open sign-up.
# ALLOWED_SIGNIN_EMAILS=you@example.com,reviewer@example.com

# One-tap demo sign-in: mints a fresh demo-* account with the demo scene per
# tap. Defaults to on in dev/test and OFF everywhere else; deployed demos set
# it explicitly.
# DEMO_LOGIN_ENABLED=1

# Logging. JSON goes to stdout on Cloud Run (it parses the lines into real log
# entries); everywhere else the format is human-readable. Set either to override.
# LOG_FORMAT=json
# LOG_LEVEL=DEBUG

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Live Google Maps/Places API integrations
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

