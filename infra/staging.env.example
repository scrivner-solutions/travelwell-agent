# Example environment file for the TravelWell deploy scripts.
#
# Copy it OUTSIDE the repo and fill in real values:
#
#   cp infra/staging.env.example ~/.travelwell-staging.env
#   chmod 600 ~/.travelwell-staging.env
#   $EDITOR ~/.travelwell-staging.env
#
# The scripts read $TRAVELWELL_STAGING_ENV, defaulting to
# ~/.travelwell-staging.env, and source it BEFORE infra/config.env. Every entry
# in config.env is ${VAR:-default}, so anything set here wins.
#
# This file holds what differs per environment. Names shared by every
# environment (service names, image names, secret names) live in config.env and
# do not belong here. Nothing here is secret: real secrets live in Secret
# Manager and are referenced by NAME only.
#
# To deploy a second environment, write a second file like this one and point
# TRAVELWELL_STAGING_ENV at it. You should never need to edit a script.

# --- Required ------------------------------------------------------------------

# The GCP project to deploy into. If unset the scripts fall back to your ambient
# `gcloud config get-value project`, which is how you deploy into the wrong
# project without noticing. Set it explicitly.
GCP_PROJECT_ID=your-project-id

# Defaults to us-central1 in the scripts if unset.
GCP_REGION=us-central1

# --- Database ------------------------------------------------------------------

# cloudsql  -> the instance below is attached to the revision.
# external  -> a hosted Postgres reached over TCP; no instance is attached.
# DATABASE_URL alone selects the target at runtime (app/db/engine.py); this only
# controls whether Cloud Run mounts the socket.
DB_TARGET=cloudsql

# Full connection name, project:region:instance. Required when DB_TARGET=cloudsql.
GCP_SQL_CONNECTION_NAME=your-project-id:us-central1:your-instance

# Short instance name, used by staging-bootstrap.sh only. Deliberately has NO
# default: bootstrap CREATES the instance when it is missing, and a default
# would quietly create one under a name nobody chose.
GCP_SQL_INSTANCE=your-instance

# --- Google OAuth ---------------------------------------------------------------

# Not secret - it travels to Google in the redirect URL and is visible in the
# browser - but it IS per-environment, since each environment has its own OAuth
# client. The matching client SECRET goes in Secret Manager under the name
# config.env gives as SECRET_GOOGLE_CLIENT_SECRET, and never appears in a file.
#
# Leave unset to deploy with Google sign-in and calendar connect switched off:
# the code answers 503 oauth_unconfigured rather than failing, and the deploy
# leaves whatever the service already has rather than blanking it.
GOOGLE_CLIENT_ID=

# --- Optional -------------------------------------------------------------------

# Override the runtime service account. Defaults to
# ${RUNTIME_SA_NAME}@${GCP_PROJECT_ID}.iam.gserviceaccount.com, which is
# normally what you want.
#GCP_RUNTIME_SA=

# Used by with-staging-db.sh to point local commands at the staging database.
# Defaults to ~/.travelwell-staging-db-url. That file holds a real connection
# string, so keep it mode 600 and outside the repo.
#STAGING_DB_URL_FILE=
