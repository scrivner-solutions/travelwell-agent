# Shared names for the TravelWell deploy scripts. Sourced by staging-bootstrap.sh,
# deploy-staging.sh and deploy-frontend-staging.sh.
#
# Nothing here is environment-specific and nothing here is secret. These are the
# names the application uses in EVERY environment, kept out of the scripts so the
# scripts hold logic and this file holds data.
#
# Every entry is `${VAR:-default}`, so anything already set wins: the scripts
# source the environment file first (TRAVELWELL_STAGING_ENV, default
# $HOME/.travelwell-staging.env, untracked) and this file second. To deploy a
# second environment, write another environment file - do not edit this one.
#
# What belongs in the ENVIRONMENT file instead, because it differs per deploy:
#   GCP_PROJECT_ID, GCP_REGION, GCP_SQL_CONNECTION_NAME, GCP_SQL_INSTANCE,
#   DB_TARGET, GCP_RUNTIME_SA, GOOGLE_CLIENT_ID
#
# GOOGLE_CLIENT_ID is not secret - it travels to Google in the redirect URL - but
# it IS per-environment, because each environment has its own OAuth client. The
# client SECRET lives in Secret Manager; only its name appears below.

# --- Cloud Run services -------------------------------------------------------
BACKEND_SERVICE="${BACKEND_SERVICE:-travelwell-backend}"
FRONTEND_SERVICE="${FRONTEND_SERVICE:-travelwell-frontend}"
MIGRATE_JOB="${MIGRATE_JOB:-travelwell-migrate}"

# --- Artifact Registry --------------------------------------------------------
AR_REPO="${AR_REPO:-travelwell}"
BACKEND_IMAGE_NAME="${BACKEND_IMAGE_NAME:-backend}"
FRONTEND_IMAGE_NAME="${FRONTEND_IMAGE_NAME:-frontend}"

# --- Secret Manager entry names (the NAMES, never the values) -----------------
SECRET_DATABASE_URL="${SECRET_DATABASE_URL:-travelwell-database-url}"
SECRET_SESSION="${SECRET_SESSION:-travelwell-session-secret}"
SECRET_TOKEN_KEY="${SECRET_TOKEN_KEY:-travelwell-token-encryption-key}"
SECRET_GOOGLE_CLIENT_SECRET="${SECRET_GOOGLE_CLIENT_SECRET:-travelwell-google-client-secret}"

# --- Service account local parts (the project is appended by the script) ------
RUNTIME_SA_NAME="${RUNTIME_SA_NAME:-travelwell-runtime}"
DEPLOYER_SA_NAME="${DEPLOYER_SA_NAME:-travelwell-deployer}"

# --- Database names -----------------------------------------------------------
DB_NAME="${DB_NAME:-travelwell}"
DB_USER="${DB_USER:-travelwell}"

# --- Workload Identity Federation ---------------------------------------------
WIF_POOL="${WIF_POOL:-github}"
WIF_PROVIDER="${WIF_PROVIDER:-travelwell-agent}"
GITHUB_REPO="${GITHUB_REPO:-scrivner-solutions/travelwell-agent}"

# --- Cloud Run sizing ---------------------------------------------------------
BACKEND_MEMORY="${BACKEND_MEMORY:-1Gi}"
FRONTEND_MEMORY="${FRONTEND_MEMORY:-256Mi}"
MAX_INSTANCES="${MAX_INSTANCES:-2}"

# --- Local development origins, listed so the deployed backend accepts them ---
DEV_ORIGINS="${DEV_ORIGINS:-http://localhost:5173,http://localhost:4173}"
